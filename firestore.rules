rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // SECURITY HELPER FUNCTIONS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    function isSalonOwner(salonId) {
      return isAuthenticated() && (
        isAdmin() ||
        (request.auth.token.role == 'salon_owner' && request.auth.token.salonId == salonId)
      );
    }

    function isStaffMember(salonId) {
      return isAuthenticated() && (
        isAdmin() ||
        (request.auth.token.role == 'staff' && request.auth.token.salonId == salonId)
      );
    }

    // ==========================================
    // 1. USERS COLLECTION
    // Customer can access only own profile;
    // Client-side role elevation is strictly blocked.
    // ==========================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Prevent user from setting admin or salon_owner role directly on account creation
      allow create: if isAuthenticated() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'customer');

      // Users cannot elevate their own role or switch assigned salonId
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'salonId', 'isVerified'])
      );

      allow delete: if isAdmin();

      // FCM device tokens: strictly private to user
      match /fcm_tokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // In-App notifications: read by recipient; create restricted to trusted server
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // ==========================================
    // 2. SALONS COLLECTION
    // Public discovery; management restricted to owner/admin
    // ==========================================
    match /salons/{salonId} {
      allow read: if true; // Public directory discovery
      allow create: if isAdmin() || (isAuthenticated() && request.auth.token.role == 'salon_owner');
      allow update: if isAdmin() || (
        isSalonOwner(salonId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'verificationStatus'])
      );
      allow delete: if isAdmin();

      // Nested services
      match /services/{serviceId} {
        allow read: if true;
        allow write: if isSalonOwner(salonId);
      }

      // Nested staff
      match /staff/{staffId} {
        allow read: if isAuthenticated();
        allow write: if isSalonOwner(salonId);
      }
    }

    // Standalone services collection
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role == 'salon_owner' &&
        request.resource.data.salonId == request.auth.token.salonId
      );
      // Verify BOTH: existing document belongs to caller's salon AND new payload belongs to caller's salon
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role == 'salon_owner' &&
        resource.data.salonId == request.auth.token.salonId &&
        request.resource.data.salonId == request.auth.token.salonId
      );
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role == 'salon_owner' &&
        resource.data.salonId == request.auth.token.salonId
      );
    }

    // Standalone staff collection
    match /staff/{staffId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role == 'salon_owner' &&
        request.resource.data.salonId == request.auth.token.salonId
      );
      // Verify BOTH: existing document belongs to caller's salon AND new payload belongs to caller's salon
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role == 'salon_owner' &&
        resource.data.salonId == request.auth.token.salonId &&
        request.resource.data.salonId == request.auth.token.salonId
      );
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role == 'salon_owner' &&
        resource.data.salonId == request.auth.token.salonId
      );
    }

    // ==========================================
    // 3. BOOKINGS COLLECTION
    // Customer can access only own bookings.
    // Salon owner accesses only their salon's bookings.
    // Staff accesses their assigned bookings.
    // Price manipulation, status skipping, and unauthorized completion blocked.
    // ==========================================
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.salonId == request.auth.token.salonId ||
        (request.auth.token.role == 'staff' && (resource.data.staffId == request.auth.uid || resource.data.salonId == request.auth.token.salonId)) ||
        isAdmin()
      );

      // Customer creates booking for themselves only with strict schema validation
      // Price must be strictly greater than zero; paymentStatus CAN NEVER be initialized as 'paid' by client
      allow create: if isAuthenticated() &&
        request.resource.data.customerUid == request.auth.uid &&
        request.resource.data.salonId is string &&
        request.resource.data.totalPrice is number &&
        request.resource.data.totalPrice > 0 &&
        request.resource.data.status in ['pending', 'confirmed'] &&
        request.resource.data.paymentStatus == 'pending';

      // Updating booking: strict lifecycle enforcement
      allow update: if isAuthenticated() && (
        isAdmin() ||
        // Salon Owner / Staff can update lifecycle status, token, stylist
        (
          (
            (request.auth.token.role == 'salon_owner' && resource.data.salonId == request.auth.token.salonId) ||
            (request.auth.token.role == 'staff' && resource.data.salonId == request.auth.token.salonId)
          ) &&
          // Cannot revert terminal states (completed, cancelled, rejected, no_show, expired)
          !(resource.data.status in ['completed', 'cancelled', 'rejected', 'no_show', 'expired']) &&
          // Cannot tamper with customerUid or locked totalPrice
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerUid', 'totalPrice'])
        ) ||
        // Customer can ONLY cancel or update safe non-financial fields
        (
          resource.data.customerUid == request.auth.uid &&
          // Cannot revert terminal states
          !(resource.data.status in ['completed', 'cancelled', 'rejected', 'no_show', 'expired']) &&
          // Customer CAN NEVER MODIFY PRICE, SALON, DURATION, PAYMENT STATUS OR MARK COMPLETE
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalPrice', 'price', 'salonId', 'customerUid', 'staffId', 'tokenNumber', 'paymentStatus']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().contains('status') ||
            request.resource.data.status == 'cancelled'
          )
        )
      );

      allow delete: if isAdmin();
    }

    // Active customer bookings marker (Server-authoritative One Active Booking tracking)
    match /active_customer_bookings/{customerUid} {
      allow read: if isAuthenticated() && (request.auth.uid == customerUid || isAdmin());
      allow write: if isAdmin();
    }

    // Staff Leaves collection
    match /staff_leaves/{leaveId} {
      allow read: if isAuthenticated() && (
        resource.data.salonId == request.auth.token.salonId ||
        isAdmin()
      );
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role in ['salon_owner', 'staff'] &&
        request.resource.data.salonId == request.auth.token.salonId
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role == 'salon_owner' &&
        resource.data.salonId == request.auth.token.salonId &&
        request.resource.data.salonId == request.auth.token.salonId
      );
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role == 'salon_owner' &&
        resource.data.salonId == request.auth.token.salonId
      );
    }

    // Walk-ins collection (Chair management)
    match /walk_ins/{walkInId} {
      allow read, write: if isAdmin() || (
        isAuthenticated() &&
        (request.auth.token.role in ['salon_owner', 'staff']) &&
        resource.data.salonId == request.auth.token.salonId
      );
    }

    // ==========================================
    // 4. PAYMENTS COLLECTION
    // Customer can access only own payments.
    // Salon Owner accesses only their salon's payments.
    // ==========================================
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.salonId == request.auth.token.salonId ||
        isAdmin()
      );

      // Restrict payment creation: only Admin, authorized Salon Owner/Staff, or customer with valid pending payment
      // Customer cannot arbitrarily create a 'paid' record or create payment for another user
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role in ['salon_owner', 'staff'] &&
        request.resource.data.salonId == request.auth.token.salonId
      ) || (
        isAuthenticated() &&
        request.resource.data.customerUid == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.bookingId is string &&
        request.resource.data.salonId is string
      );

      // Updating payment: only Admin, or Salon Owner / authorized Staff for their own salon
      // Customers CANNOT modify payments. Critical IDs and amounts cannot be forged or altered.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role in ['salon_owner', 'staff'] &&
        resource.data.salonId == request.auth.token.salonId &&
        request.resource.data.salonId == request.auth.token.salonId &&
        request.resource.data.customerUid == resource.data.customerUid &&
        request.resource.data.bookingId == resource.data.bookingId &&
        request.resource.data.amount == resource.data.amount
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 5. REVIEWS COLLECTION
    // Public read; authenticated customers author review
    // ==========================================
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.customerUid == request.auth.uid;
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.customerUid == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customerUid', 'salonId'])
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.customerUid == request.auth.uid);
    }

    // ==========================================
    // 6. SALON CLOSURES COLLECTION
    // Public read (to show customers closed days);
    // Modified only by authorized salon owner or admin.
    // ==========================================
    match /salon_closures/{closureId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role == 'salon_owner' &&
        request.resource.data.salonId == request.auth.token.salonId
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role == 'salon_owner' &&
        resource.data.salonId == request.auth.token.salonId &&
        request.resource.data.salonId == request.auth.token.salonId
      );
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        request.auth.token.role == 'salon_owner' &&
        resource.data.salonId == request.auth.token.salonId
      );
    }

    // ==========================================
    // 7. ADMIN SETTINGS & PLATFORM CONFIGS
    // ==========================================
    match /admin_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /admin_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_offers/{offerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Deduplication table: server-only
    match /processed_events/{eventId} {
      allow read, write: if false;
    }
  }
}
